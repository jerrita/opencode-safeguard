{
  "name": "opencode-safeguard",
  "version": "0.1.1",
  "description": "Sensitive-data safeguard for OpenCode: redacts secrets before they reach the LLM, restores them before local tool execution.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./rpc": "./dist/rpc.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-tui.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.tui.json",
    "test": "vitest run",
    "fmt": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "vendor-rules": "node scripts/vendor-rules.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/plugin": "2.0.31",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "babel-preset-solid": "1.9.12",
    "prettier": "^3.3.3",
    "smol-toml": "^1.3.2",
    "solid-js": "1.9.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "^2.0.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  }
}
