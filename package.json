{
  "name": "opencode-safeguard",
  "version": "0.1.0",
  "description": "Sensitive-data safeguard for OpenCode: redacts secrets before they reach the LLM, restores them before local tool execution.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./rpc": "./dist/rpc.js",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "dist",
    "src/tui.tsx",
    "src/rpc.ts",
    "src/state.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.tui.json",
    "test": "vitest run",
    "fmt": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "vendor-rules": "node scripts/vendor-rules.mjs"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.31",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "prettier": "^3.3.3",
    "smol-toml": "^1.3.2",
    "solid-js": "^1.9.17",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "^2.0.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  }
}
